FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/files/heygen-workflow/runtime/vector-cache/models

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vector-cpu.txt /tmp/requirements-vector-cpu.txt
RUN python -m pip install --no-cache-dir 'torch==2.11.0+cpu' --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r /tmp/requirements-vector-cpu.txt

WORKDIR /files/heygen-workflow
CMD ["python", "vector-retrieval-service.py"]
