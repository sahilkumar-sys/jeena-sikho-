# These variables must be injected into the n8n container environment.
# Keep real secrets in Docker's .env/secrets, never in workflow JSON or CSV.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_STT_USD_PER_HOUR=0.22

# One Google AI Studio key for BOTH B-roll planning and image generation.
GEMINI_API_KEY=
# Google's OpenAI-compatible endpoint still uses your Gemini account and key.
LLM_PROVIDER=gemini
# Legacy key used only with non-Gemini planning providers.
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-3.8-flash
# B-roll shots last 2.5–3.0 seconds and aim for approximately 50% of the timeline.

# Gemini image generation uses the same GEMINI_API_KEY above.
IMAGE_PROVIDER=gemini
# IMAGE_API_KEY is used only when IMAGE_PROVIDER=openai.
IMAGE_API_KEY=
IMAGE_API_URL=https://generativelanguage.googleapis.com/v1/models/{model}:generateContent
IMAGE_MODEL=gemini-3.1-flash-image
# OpenAI pixel size; Gemini generates vertical 9:16 stills at 2K by default.
IMAGE_SIZE=1024x1024
# Optional override; inject this variable into the container if changing it.
GEMINI_IMAGE_SIZE=2K
BACKGROUND_MUSIC_PATH=
TRANSITION_SOUND_PATH=/files/heygen-workflow/woosh-sound-effect.mp3

# Approved subtitle appearance and short on-screen chunks (2–3 words each).
CAPTION_MAX_WORDS=3
# Captions are spelling/grammar checked with the configured LLM before rendering.
# Leave blank to use LLM_MODEL; setting a different model requires provider support.
CAPTION_LLM_MODEL=
# Set to false only when a cached caption correction must be rerun.
REUSE_EXISTING_CAPTIONS=true
SUBTITLE_STYLE_FILE=/files/heygen-workflow/ayurveda-subtitles-tiro-amber.ass
SUBTITLE_FONTS_DIR=/files/heygen-workflow/fonts

# Avatar green-screen composition. Defaults match Avatar_Video.mp4 and the
# approved still preview. Disable for videos that are already fully composed.
AVATAR_COMPOSITE_ENABLED=true
AVATAR_CROP_X=0
AVATAR_CROP_Y=657
AVATAR_CROP_WIDTH=1080
AVATAR_CROP_HEIGHT=606
AVATAR_KEY_COLOR=0x88b943
AVATAR_KEY_SIMILARITY=0.075
AVATAR_KEY_BLEND=0.025
AVATAR_DESPILL_MIX=0.65
AVATAR_BACKGROUND_COLOR=0xB69966
AVATAR_ZOOM_X=3.01
AVATAR_ZOOM_Y=3.0
AVATAR_POSITION_X=-30
AVATAR_POSITION_Y=-48

# Image-first edits use one to three closely relevant stock-video shots; the other
# B-roll shots use product/reference photos or generated Indian-focused stills.
# Stills receive a subtle out-to-in zoom. libx264 works without Docker GPU access.
VIDEO_ENCODER=libx264
IMAGE_TRANSITION_SECONDS=0.35
MAX_VIDEOS_PER_RUN=1
REUSE_EXISTING_TRANSCRIPT=true
REUSE_EXISTING_PLAN=true
REUSE_EXISTING_IMAGES=true
API_TIMEOUT_SECONDS=300
MIN_VIDEO_AGE_SECONDS=30
AUTO_PROCESS_NEW_VIDEOS=true

# B-roll search (Phase 1, 7 October 2026). Goal is all-video B-roll.
# Generated stills allowed per reel; real product/social/hospital photos do not count.
BROLL_MAX_GENERATED_STILLS=2
# Minimum blended vector rank score for a clip to be offered as a match.
# Calibrated at 0.18 on the 1 fps index; blank uses that default.
BROLL_MIN_MATCH_SCORE=
# Fit check (Phase 2): a planned video shot scoring below this everywhere, with no
# better approved clip, is dropped so the presenter stays on screen. Blank = 0.14.
BROLL_DROP_BELOW_SCORE=
# Quality/Quantity (Phase 3). n8n passes --broll-mode from its Set node, which wins over this.
# quantity = always render; quality = stop and list Envato clips when an important moment lacks a good video.
BROLL_MODE=quantity
# Optional: where job inboxes for downloaded Envato clips live. Blank = <project>/broll-inbox.
BROLL_INBOX_DIR=

# The n8n Set node uses a fixed max_videos=1 to avoid blocked $env expressions.
# Change that node's fixed number to adjust its batch size; the environment value
# above is the fallback for direct CLI runs without --max-videos.
# Docker/Linux flock is required. Never delete live *.lock/.factory.lock files.

# Separate Meta publisher. Leave account fields empty until setup; drafts still
# require GEMINI_API_KEY. Approval happens in publishing/queue/*.json.
# Optional lower-cost title/description model; defaults to LLM_MODEL when blank.
PUBLISHING_LLM_MODEL=
META_GRAPH_VERSION=v26.0
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
